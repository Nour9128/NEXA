# ==============================================================================
# NEXA — Global Environment Variables
# ==============================================================================

# Server Port & Node Environment
PORT=4000
NODE_ENV=development

# PostgreSQL Database Connection
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=public
DATABASE_URL="postgresql://postgres@localhost:5432/nexa_db?schema=public"

# JSON Web Token Secret Keys (Use min 32 characters in production)
JWT_SECRET="nexa-super-secret-jwt-key-production-grade-2026-xyz"
JWT_REFRESH_SECRET="nexa-super-secret-refresh-key-production-grade-2026-abc"

# AI Provider Configuration (OpenAI SDK)
# If left blank, NEXA runs in development mode with heuristic preview assistance
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Frontend Application URL (Used for CORS and Invitation Links)
FRONTEND_URL="http://localhost:5173"
