# NEXA Environment Configuration Example
PORT=4000
NODE_ENV=development
DATABASE_URL="postgresql://postgres:password@localhost:5432/nexa_db?schema=public"
JWT_SECRET="your-jwt-secret-min-32-chars-long"
JWT_REFRESH_SECRET="your-refresh-secret-min-32-chars-long"
# AI Provider Configuration (Google Gemini or OpenAI)
OPENAI_API_KEY="AQ.your-gemini-key-or-sk-openai-key"
OPENAI_MODEL="gemini-3.8-flash"
OPENAI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"
# Optional explicit Gemini key
GEMINI_API_KEY=""
FRONTEND_URL="http://localhost:5173"
